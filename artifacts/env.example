# SQLite database (path relative to prisma/schema.prisma — NOT /app/.data unless inside Docker)
DATABASE_URL="file:../.data/mycontrol.db"

# Session secret (min 32 chars) - generate with: openssl rand -base64 32
SESSION_SECRET="change-me-to-a-random-32-char-or-longer-secret"

# Encryption key for SSH credentials (32 bytes base64) - generate with: openssl rand -base64 32
ENCRYPTION_KEY="change-me-to-a-random-32-byte-base64-key"

# Admin secrets vault UI — strong password (min 32 chars); unlock to view decrypted SSH secrets in Admin → Vault
SECRETS_VAULT_PASSWORD="change-me-to-a-strong-vault-password"

# App — use your LAN IP so Proxmox hosts can reach this console (not localhost)
APP_URL="http://10.1.3.230:3000"
SESSION_COOKIE_SECURE=false
# Do NOT set NODE_ENV here — Next.js sets it (dev/build/start). Wrong values break `next build`.

# Run command worker inside the Next.js process (no separate worker needed)
RUN_EMBEDDED_WORKER="true"

# Security
MAX_CONCURRENT_SSH="5"
SESSION_MAX_AGE_HOURS="24"
AUDIT_LOG_RETENTION_DAYS="365"
